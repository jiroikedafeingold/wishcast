    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcast verwendet deinen Standort, um Prognosen für deinen Aufenthaltsort zu finden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Wishcast uses your location to find forecasts for where you are."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcast usa tu ubicación para buscar previsiones del lugar donde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcast utilise votre position pour trouver les prévisions de l’endroit où vous êtes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcast usa la tua posizione per trovare le previsioni del luogo in cui ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcastは現在地の予報を探すために位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcast는 현재 있는 곳의 예보를 찾기 위해 위치를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Wishcast usa sua localização para encontrar previsões de onde você está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcast использует ваше местоположение, чтобы найти прогнозы для места, где вы находитесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcast 使用你的位置来查找你所在地的预报。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wishcast 使用你的位置來尋找你所在地的預報。"
          }
        }
      }
    }
