    "Swipe left or right on the main screen to move between favorites. Drag to reorder." : {
      "comment" : "A description of the interface for moving and deleting saved places.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
