    "More than a week out, forecasts lose much of their skill and fewer models reach this far. Treat this as a long shot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als eine Woche im Voraus verlieren Prognosen viel von ihrer Treffsicherheit, und weniger Modelle reichen so weit. Betrachte das als Glücksspiel."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A más de una semana vista, las previsiones pierden gran parte de su acierto y menos modelos llegan tan lejos. Tómalo como una apuesta arriesgada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À plus d’une semaine, les prévisions perdent beaucoup de leur fiabilité et moins de modèles vont aussi loin. Considérez ceci comme un pari risqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A più di una settimana, le previsioni perdono gran parte della loro affidabilità e meno modelli arrivano così lontano. Consideralo una scommessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1週間以上先になると、予報は精度の多くを失い、ここまで届くモデルも少なくなります。大穴と考えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일주일 이상 먼 날은 예보의 정확도가 많이 떨어지고 도달하는 모델도 적습니다. 모험으로 생각하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com mais de uma semana de antecedência, as previsões perdem boa parte da precisão e menos modelos chegam tão longe. Considere uma aposta arriscada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше чем на неделю вперёд прогнозы теряют значительную часть точности, и так далеко доходит меньше моделей. Считайте это рискованной ставкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过一周之后，预报会失去大部分准确性，能覆盖到的模型也更少。请把它当作冷门押注。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過一週之後，預報會失去大部分準確度，能涵蓋到的模式也較少。請把它當作冷門押注。"
          }
        }
      }
    },
    "More than two weeks out, wild guess." : {
      "comment" : "Explanation of the forecast range when it's more than two weeks out.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr als zwei Wochen voraus: wilder Tipp."
