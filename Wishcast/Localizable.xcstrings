    "So it isn’t a prediction" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Also ist sie keine Vorhersage"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
