    "Current conditions, a 7-day outlook, hourly forecasts and a widget, all laid out like any other weather app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Bedingungen, ein 7-Tage-Ausblick, stündliche Prognosen und ein Widget – aufgebaut wie jede andere Wetter-App."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condiciones actuales, perspectiva a 7 días, previsión por horas y un widget, todo dispuesto como en cualquier otra app del tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions actuelles, tendance sur 7 jours, prévisions heure par heure et un widget, présentés comme dans n’importe quelle autre app météo."
          }
        },
        "it" : {
          "stringUnit" : {
