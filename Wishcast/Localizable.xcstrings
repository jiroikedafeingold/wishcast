            "value" : "Nicht Teil des Wunsches: Diese Werte stammen aus einer einzigen Standardprognose."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No forma parte del deseo: estos datos vienen de una sola previsión estándar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hors souhait : ces valeurs proviennent d’une seule prévision standard."
          }
