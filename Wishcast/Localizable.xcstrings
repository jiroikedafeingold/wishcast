    "Choose a place and Sunnyside will compare more than 200 forecasts from weather services around the world to find the best case for the weather you're hoping for." : {
      "comment" : "A description of the content of the \"Choose a place\" section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ort, und Sunnyside vergleicht mehr als 200 Prognosen von Wetterdiensten auf der ganzen Welt, um den besten Fall für das Wetter zu finden, auf das du hoffst."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un lugar y Sunnyside comparará más de 200 previsiones de servicios meteorológicos de todo el mundo para encontrar el mejor caso del tiempo que esperas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un lieu et Sunnyside comparera plus de 200 prévisions de services météo du monde entier pour trouver le meilleur cas de la météo que vous espérez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un luogo e Sunnyside confronterà più di 200 previsioni di servizi meteo di tutto il mondo per trovare il caso migliore del tempo che speri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
