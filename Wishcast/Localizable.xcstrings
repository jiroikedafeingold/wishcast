          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一致とは、混ぜていない1つの予報が次を示すことです：%@ これは予報の数であり、確率ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일치란 섞지 않은 하나의 예보가 다음을 보여 준다는 뜻입니다: %@ 이것은 예보의 개수이지 확률이 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
