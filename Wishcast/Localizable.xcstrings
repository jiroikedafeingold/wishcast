    "Forecasts reach %@. The first 7 days are a best case, days 8–14 a long shot, and anything later a wild guess." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prognosen reichen bis %@. Die ersten 7 Tage sind ein bester Fall, Tag 8–14 ein Glücksspiel und alles danach ein wilder Tipp."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las previsiones llegan hasta el %@. Los primeros 7 días son un mejor caso, los días 8–14 una apuesta arriesgada y lo demás una corazonada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prévisions vont jusqu’au %@. Les 7 premiers jours sont un meilleur cas, les jours 8 à 14 un pari risqué, et au-delà un coup de dés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le previsioni arrivano fino al %@. I primi 7 giorni sono un caso migliore, i giorni 8–14 una scommessa e il resto un tiro a indovinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予報は%@まで。最初の7日間はベストケース、8〜14日目は大穴、それ以降は当てずっぽうです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예보는 %@까지입니다. 처음 7일은 최상의 경우, 8–14일째는 모험, 그 이후는 엉뚱한 추측입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As previsões vão até %@. Os primeiros 7 dias são um melhor cenário, os dias 8–14 uma aposta arriscada e o resto um chute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогнозы доходят до %@. Первые 7 дней — лучший случай, дни 8–14 — рискованная ставка, а дальше — догадка наугад."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "预报覆盖到 %@。前 7 天是最佳情况，第 8–14 天是冷门押注，再往后就是瞎猜。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預報涵蓋到 %@。前 7 天是最佳情況，第 8–14 天是冷門押注，再往後就是亂猜。"
          }
        }
      }
    },
