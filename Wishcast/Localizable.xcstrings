    "Each dot is one of %lld forecasts, sorted low to high. The big dot is the one picked, even when it's far from the rest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Punkt ist eine von %lld Prognosen, aufsteigend sortiert. Der große Punkt ist der ausgewählte, auch wenn er weit von den anderen entfernt ist."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada punto es una de %lld previsiones, ordenadas de menor a mayor. El punto grande es el elegido, aunque esté lejos del resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque point est l’une des %lld prévisions, triées de la plus basse à la plus haute. Le gros point est celui choisi, même s’il est loin des autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni punto è una di %lld previsioni, ordinate dalla più bassa alla più alta. Il punto grande è quello scelto, anche quando è lontano dagli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各点は%lld件の予報の1つで、低い順に並んでいます。大きな点が選ばれた予報です。ほかから大きく離れていても同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 점은 %lld개 예보 중 하나이며 낮은 순으로 정렬되어 있습니다. 큰 점이 선택된 예보이며, 다른 점들과 멀리 떨어져 있어도 마찬가지입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada ponto é uma de %lld previsões, ordenadas da menor para a maior. O ponto grande é o escolhido, mesmo quando está longe dos outros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждая точка — один из прогнозов (всего %lld), по возрастанию. Большая точка — выбранная, даже если она далеко от остальных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个点是 %lld 个预报之一，按从低到高排列。大点是选中的那个，即使它离其他点很远。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個點是 %lld 個預報之一，由低到高排列。大點是選中的那個，即使它離其他點很遠。"
          }
        }
      }
    },
