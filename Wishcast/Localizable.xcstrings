    },
    "A match means one unmixed forecast shows: %@ This is a count of forecasts, not a probability." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Treffer bedeutet, dass eine ungemischte Prognose Folgendes zeigt: %@ Das ist eine Anzahl von Prognosen, keine Wahrscheinlichkeit."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una coincidencia significa que una previsión sin mezclar muestra: %@ Es un recuento de previsiones, no una probabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une correspondance signifie qu’une prévision non mélangée indique : %@ C’est un nombre de prévisions, pas une probabilité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
