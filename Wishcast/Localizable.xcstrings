    "Midnight to midnight in the location's local time. A forecast with fewer than 20 hours of data for a day is left out of that day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Mitternacht bis Mitternacht in der Ortszeit. Eine Prognose mit weniger als 20 Stunden Daten für einen Tag wird für diesen Tag nicht berücksichtigt."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De medianoche a medianoche en la hora local del lugar. Una previsión con menos de 20 horas de datos para un día no se tiene en cuenta ese día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De minuit à minuit, à l’heure locale du lieu. Une prévision comptant moins de 20 heures de données pour un jour est écartée pour ce jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da mezzanotte a mezzanotte, nell’ora locale del luogo. Una previsione con meno di 20 ore di dati per un giorno viene esclusa da quel giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その地点の現地時間で午前0時から午前0時まで。ある日のデータが20時間未満の予報は、その日の計算から除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 장소의 현지 시간 기준 자정부터 자정까지. 하루의 데이터가 20시간 미만인 예보는 그날에서 제외됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De meia-noite a meia-noite, no horário local do lugar. Uma previsão com menos de 20 horas de dados para um dia fica de fora desse dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С полуночи до полуночи по местному времени. Прогноз, в котором за день меньше 20 часов данных, для этого дня не учитывается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按当地时间从午夜到午夜。某天数据少于 20 小时的预报不计入当天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依當地時間從午夜到午夜。某天資料少於 20 小時的預報不計入當天。"
          }
        }
      }
    },
