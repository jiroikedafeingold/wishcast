    "The best case for your wish over the next four days, from your iPhone.": {
      "comment": "Description of the widget that shows the best case for the user's wish over the next four days.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der beste Fall für deinen Wunsch in den nächsten vier Tagen, von deinem iPhone."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El mejor caso para tu deseo en los próximos cuatro días, desde tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le meilleur cas pour votre souhait sur les quatre prochains jours, depuis votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il caso migliore per il tuo desiderio nei prossimi quattro giorni, dal tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneから届く、今後4日間の願いに合わせたベストケース。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 가져온, 앞으로 4일 동안 소원에 맞춘 최상의 경우."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O melhor cenário para o seu desejo nos próximos quatro dias, do seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучший случай для вашего желания на ближайшие четыре дня — с iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 iPhone，按你的愿望给出的未来四天最佳情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 iPhone，依你的心願給出的未來四天最佳情況。"
          }
        }
      }
    },
