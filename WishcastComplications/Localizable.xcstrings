  "sourceLanguage": "en",
  "strings": {
    "Today's best case for your wish, from your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der beste Fall für heute zu deinem Wunsch, von deinem iPhone."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El mejor caso de hoy para tu deseo, desde tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le meilleur cas du jour pour votre souhait, depuis votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il caso migliore di oggi per il tuo desiderio, dal tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneから届く、願いに合わせた今日のベストケース。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 가져온, 소원에 맞춘 오늘의 최상의 경우."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O melhor cenário de hoje para o seu desejo, do seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучший случай на сегодня для вашего желания — с iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 iPhone，按你的愿望给出的今日最佳情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 iPhone，依你的心願給出的今日最佳情況。"
          }
        }
      }
    },
